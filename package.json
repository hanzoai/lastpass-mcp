{
  "name": "@hanzo/lastpass-mcp",
  "version": "0.1.0",
  "description": "Native LastPass MCP server & Hanzo Egress / KMS / ZAP browser autofill bridge with zero credential exposure",
  "license": "Apache-2.0 AND GPL-2.0-or-later",
  "author": "Hanzo AI Inc. <dev@hanzo.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/lastpass-mcp.git"
  },
  "homepage": "https://github.com/hanzoai/lastpass-mcp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lastpass-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "NOTICE",
    "README.md",
    "LLM.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "build:all": "make build",
    "test": "npm run build && node --test dist-test/test/lastpass-mcp.test.js",
    "pretest": "tsc -p tsconfig.test.json",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli.js --http --port 3847"
  },
  "keywords": [
    "lastpass",
    "mcp",
    "model-context-protocol",
    "hanzo",
    "kms",
    "egress",
    "zap",
    "autofill",
    "zero-trust"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
